[user]
  signingkey = <KEY>
  name = <NAME>
  email = <EMAIL>

[gpg]
  format = ssh

[gpg "ssh"]
  program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
  allowedSignersFile = </PATH/TO/allowed_signers>

[commit]
  gpgsign = true

# When testing this, remember that you have to be in a Git repo and not just a subdir of ~/WORK_DIR
[includeIf "gitdir:~/WORK_DIR/"]
  path = ~/.gitconfig.work.local